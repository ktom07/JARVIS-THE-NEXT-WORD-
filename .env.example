# J.A.R.V.I.S. Predict Environment Configuration
PORT=3000

# Choose your preferred LLM provider: "claude" (Chatty), "grok", "gemini", "openai", or "auto"
LLM_PROVIDER=claude

# Chatty Powered by Claude / Anthropic API (Get at https://console.anthropic.com/)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# xAI Grok API (Get at https://console.x.ai/)
XAI_API_KEY=
GROK_MODEL=grok-2-mini

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
